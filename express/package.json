{
  "name": "link-shortener-backend",
  "version": "1.0.0",
  "description": "Express backend for link shortener",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "6.16.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.4.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "winston": "3.18.0",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.1",
    "@types/passport": "1.0.16",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.16.0",
    "supertest": "7.1.3",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.7.2"
  }
}
